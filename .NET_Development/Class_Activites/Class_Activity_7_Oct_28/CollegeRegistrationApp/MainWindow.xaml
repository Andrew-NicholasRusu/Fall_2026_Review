<Window x:Class="CollegeRegistrationApp.MainWindow"
    
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    
    xmlns:local="clr-namespace:CollegeRegistrationApp"
        mc:Ignorable="d"
    Title="College Course Registration System" 
    Height="650" Width="850"
    MinHeight="550" MinWidth="750"
    WindowStartupLocation="CenterScreen"
    Background="#F4F6F9">

    <!-- Window Resources: Styles and Triggers (Part F) -->
    <Window.Resources>
        <!-- 1. Implicit Style for all TextBox controls (Part F Req 1) -->
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderBrush" Value="#C9DCF0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <!-- Focus Trigger (Part F Req 3) -->
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#1B5E94"/>
                    <Setter Property="Background" Value="#F8FBFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 2. Explicit Style for Primary Action Buttons (Part F Req 2 & 3) -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1B5E94"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderBrush" Value="#154B77"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Mouse Hover Trigger (Part F Req 3) -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2572B2"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#0D3B66"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#12446E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Explicit Style for Confirm Registration Button (Green theme with hover trigger) -->
        <Style x:Key="ConfirmButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2E7D32"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderBrush" Value="#1B5E20"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Mouse Hover Trigger (Part F Req 3) -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#388E3C"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#1B5E20"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1B5E20"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Explicit Style for Clear Form Button (Neutral theme with hover trigger) -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F8F9FA"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderBrush" Value="#C9DCF0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Mouse Hover Trigger (Part F Req 3) -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E2E8F0"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0"
                Background="#1B5E94"
                CornerRadius="6"
                Padding="12,8"
                Margin="0,0,0,10">
            <Viewbox MaxHeight="45">
                <TextBlock Text="College Course Registration System"
                           FontWeight="Bold"
                           FontSize="20"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Viewbox>
        </Border>
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="340"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*" MinWidth="340"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <Border Background="White"
                        BorderBrush="#C9DCF0"
                        BorderThickness="1"
                        CornerRadius="5"
                        Margin="0,0,0,10">
                    <StackPanel>
                        <Border Background="#E6F2FA"
                                CornerRadius="4,4,0,0"
                                Padding="8,6"
                                BorderBrush="#C9DCF0"
                                BorderThickness="0,0,0,1">
                            <TextBlock Text="Student Information"
                                       FontWeight="Bold"
                                       Foreground="#1B5E94"
                                       FontSize="13"/>
                        </Border>
                        <Grid Margin="10,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <!-- Full Name (Bound to StudentName) -->
                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="Full Name:"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Margin="0,4"/>
                            <TextBox Grid.Row="0" Grid.Column="1"
                                     x:Name="txtFullName"
                                     Text="{Binding StudentName, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                     Margin="0,4"
                                     Padding="4,2"
                                     TextChanged="TextBox_FullName"/>
                            <TextBlock Grid.Row="1" Grid.Column="0"
                                       Text="Student ID:"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Margin="0,4"/>
                            <TextBox Grid.Row="1" Grid.Column="1"
                                     x:Name="txtStudentID"
                                     Margin="0,4"
                                     Padding="4,2"
                                     TextChanged="TextBox_StudentID"/>
                            <TextBlock Grid.Row="2" Grid.Column="0"
                                       Text="Email Address:"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Margin="0,4"/>
                            <TextBox Grid.Row="2" Grid.Column="1"
                                     x:Name="txtEmailAddress"
                                     Margin="0,4"
                                     Padding="4,2"
                                     TextChanged="TextBox_EmailAddress"/>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Background="White"
                        BorderBrush="#C9DCF0"
                        BorderThickness="1"
                        CornerRadius="5"
                        Margin="0,0,0,10">
                    <StackPanel>
                        <Border Background="#E6F2FA"
                                CornerRadius="4,4,0,0"
                                Padding="8,6"
                                BorderBrush="#C9DCF0"
                                BorderThickness="0,0,0,1">
                            <TextBlock Text="Course Selection"
                                       FontWeight="Bold"
                                       Foreground="#1B5E94"
                                       FontSize="13"/>
                        </Border>
                        <StackPanel Margin="10,8">
                            <Grid Margin="0,4">
                                <RadioButton x:Name="rbIntroProg"
                                             Content="Introduction to Programming"
                                             GroupName="Courses"
                                             IsChecked="True"
                                             HorizontalAlignment="Left"
                                             VerticalAlignment="Center"
                                             Checked="RadioButton_Intro_To_Programming"/>
                                <TextBlock Text="$120"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Foreground="#333333"/>
                            </Grid>
                            <Grid Margin="0,4">
                                <RadioButton x:Name="rbWebDev"
                                             Content="Web Development"
                                             GroupName="Courses"
                                             HorizontalAlignment="Left"
                                             VerticalAlignment="Center"
                                             Checked="RadioButton_Web_Development"/>
                                <TextBlock Text="$150"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Foreground="#333333"/>
                            </Grid>
                            <Grid Margin="0,4">
                                <RadioButton x:Name="rbDbFund"
                                             Content="Database Fundamentals"
                                             GroupName="Courses"
                                             HorizontalAlignment="Left"
                                             VerticalAlignment="Center"
                                             Checked="RadioButton_Database_Fundamentals"/>
                                <TextBlock Text="$180"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Foreground="#333333"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <!-- 3. Optional Services Card -->
                <Border Background="White"
                        BorderBrush="#C9DCF0"
                        BorderThickness="1"
                        CornerRadius="5"
                        Margin="0,0,0,10">
                    <StackPanel>
                        <Border Background="#E6F2FA"
                                CornerRadius="4,4,0,0"
                                Padding="8,6"
                                BorderBrush="#C9DCF0"
                                BorderThickness="0,0,0,1">
                            <TextBlock Text="Optional Services"
                                       FontWeight="Bold"
                                       Foreground="#1B5E94"
                                       FontSize="13"/>
                        </Border>
                        <StackPanel x:Name="pnlOptionalServices" Margin="10,8" IsEnabled="False">
                            <!-- Service 1: Printed Course Materials ($25) -->
                            <Grid Margin="0,4">
                                <CheckBox x:Name="chkPrintedMaterials"
                                          Content="Printed Course Materials"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          Checked="OptionalService_Changed"
                                          Unchecked="OptionalService_Changed"/>
                                <TextBlock Text="$25"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Foreground="#333333"/>
                            </Grid>
                            <!-- Service 2: Parking Permit ($40) -->
                            <Grid Margin="0,4">
                                <CheckBox x:Name="chkParkingPermit"
                                          Content="Parking Permit"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          Checked="OptionalService_Changed"
                                          Unchecked="OptionalService_Changed"/>
                                <TextBlock Text="$40"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Foreground="#333333"/>
                            </Grid>
                            <!-- Service 3: Certificate of Completion ($15) -->
                            <Grid Margin="0,4">
                                <CheckBox x:Name="chkCertificate"
                                          Content="Certificate of Completion"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          Checked="OptionalService_Changed"
                                          Unchecked="OptionalService_Changed"/>
                                <TextBlock Text="$15"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Foreground="#333333"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <!-- 4. Registration Status Card -->
                <Border Background="White"
                        BorderBrush="#C9DCF0"
                        BorderThickness="1"
                        CornerRadius="5"
                        Margin="0,0,0,10">
                    <StackPanel>
                        <Border Background="#E6F2FA"
                                CornerRadius="4,4,0,0"
                                Padding="8,6"
                                BorderBrush="#C9DCF0"
                                BorderThickness="0,0,0,1">
                            <TextBlock Text="Registration Status"
                                       FontWeight="Bold"
                                       Foreground="#1B5E94"
                                       FontSize="13"/>
                        </Border>
                        <StackPanel Margin="10,8">
                            <CheckBox x:Name="chkRegistrationStatus"
                                      Content="Not Started (Unchecked)"
                                      IsThreeState="True"
                                      IsChecked="False"
                                      FontWeight="SemiBold"
                                      Margin="0,4"
                                      Checked="RegistrationStatus_Changed"
                                      Unchecked="RegistrationStatus_Changed"
                                      Indeterminate="RegistrationStatus_Changed"/>
                            <TextBlock x:Name="txtStatusDescription"
                                       Text="Optional services are disabled and registration cannot be confirmed."
                                       FontSize="11"
                                       Foreground="#757575"
                                       TextWrapping="Wrap"
                                       Margin="20,2,0,4"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <!-- 5. Welcome Card (Part E - Data Binding) -->
                <Border Background="White"
                        BorderBrush="#C9DCF0"
                        BorderThickness="1"
                        CornerRadius="5"
                        Margin="0,0,0,10">
                    <StackPanel>
                        <Border Background="#E6F2FA"
                                CornerRadius="4,4,0,0"
                                Padding="8,6"
                                BorderBrush="#C9DCF0"
                                BorderThickness="0,0,0,1">
                            <TextBlock Text="Welcome"
                                       FontWeight="Bold"
                                       Foreground="#1B5E94"
                                       FontSize="13"/>
                        </Border>
                        <StackPanel Margin="12,10">
                            <TextBlock Text="{Binding WelcomeMessage}"
                                       FontWeight="Bold"
                                       FontSize="16"
                                       Foreground="#1B5E94"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="Please complete your registration details."
                                       FontSize="11"
                                       Foreground="#666666"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <!-- 6. Registration Summary Card (Part A Req 6, Part B Req 4) -->
                <Border Background="White"
                        BorderBrush="#C9DCF0"
                        BorderThickness="1"
                        CornerRadius="5"
                        Margin="0,0,0,10">
                    <StackPanel>
                        <Border Background="#E6F2FA"
                                CornerRadius="4,4,0,0"
                                Padding="8,6"
                                BorderBrush="#C9DCF0"
                                BorderThickness="0,0,0,1">
                            <TextBlock Text="Registration Summary"
                                       FontWeight="Bold"
                                       Foreground="#1B5E94"
                                       FontSize="13"/>
                        </Border>
                        <StackPanel Margin="12,10">
                            <!-- Selected Course Row -->
                            <TextBlock Text="Selected Course:"
                                       FontWeight="Bold"
                                       FontSize="12"
                                       Foreground="#333333"
                                       Margin="0,0,0,4"/>
                            <Grid Margin="10,0,0,6">
                                <TextBlock x:Name="txtSummaryCourse"
                                           Text="Introduction to Programming"
                                           Foreground="#555555"
                                           HorizontalAlignment="Left"/>
                                <TextBlock x:Name="txtSummaryCourseFee"
                                           Text="$120"
                                           FontWeight="SemiBold"
                                           Foreground="#333333"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                            <!-- Optional Services Section -->
                            <TextBlock Text="Optional Services:"
                                       FontWeight="Bold"
                                       FontSize="12"
                                       Foreground="#333333"
                                       Margin="0,4,0,4"/>
                            <StackPanel x:Name="pnlSummaryServices" Margin="10,0,0,6">
                                <TextBlock x:Name="txtSummaryNoServices"
                                           Text="None"
                                           Foreground="#888888"
                                           FontStyle="Italic"/>
                                <Grid x:Name="rowSummaryPrintedMaterials" Visibility="Collapsed" Margin="0,2">
                                    <TextBlock Text="Printed Course Materials" Foreground="#555555" HorizontalAlignment="Left"/>
                                    <TextBlock Text="$25" FontWeight="SemiBold" Foreground="#333333" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid x:Name="rowSummaryParkingPermit" Visibility="Collapsed" Margin="0,2">
                                    <TextBlock Text="Parking Permit" Foreground="#555555" HorizontalAlignment="Left"/>
                                    <TextBlock Text="$40" FontWeight="SemiBold" Foreground="#333333" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid x:Name="rowSummaryCertificate" Visibility="Collapsed" Margin="0,2">
                                    <TextBlock Text="Certificate of Completion" Foreground="#555555" HorizontalAlignment="Left"/>
                                    <TextBlock Text="$15" FontWeight="SemiBold" Foreground="#333333" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                            <Separator Background="#D0D7DE" Margin="0,4,0,8"/>
                            <!-- Total Fee Row -->
                            <Grid>
                                <TextBlock Text="Total Fee:"
                                           FontWeight="Bold"
                                           FontSize="14"
                                           VerticalAlignment="Center"
                                           Foreground="#333333"/>
                                <TextBlock x:Name="txtSummaryTotalFee"
                                           Text="$120"
                                           FontWeight="Bold"
                                           FontSize="18"
                                           Foreground="#1B5E94"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,4,0,0">
            <Button x:Name="btnCalculateTotal"
                    Content="Calculate Total"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Width="140" Height="34"
                    Margin="6,0"
                    Click="btnCalculateTotal_Click"/>

            <Button x:Name="btnConfirmRegistration"
                    Content="Confirm Registration"
                    Style="{StaticResource ConfirmButtonStyle}"
                    Width="160" Height="34"
                    Margin="6,0"
                    Click="btnConfirmRegistration_Click"/>

            <Button x:Name="btnClearForm"
                    Content="Clear Form"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Width="130" Height="34"
                    Margin="6,0"
                    Click="btnClearForm_Click"/>
        </StackPanel>
    </Grid>
</Window>