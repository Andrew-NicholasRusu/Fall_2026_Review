<Window x:Class="MessageBoxPractice.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MessageBoxPractice"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Button 
            x:Name="ShowMessageButton"
            Content="Show Information Message"
            Width="350"
            Height="40"
            Background ="AliceBlue"
            Click="ShowMessageButton_Click" Margin="225,109,225,285"/>
        <Button
             x:Name="ShowWarningButton"
             Content="Show Warning Message"
             Width="350"
             Height="40"
             Background ="LightYellow"
             Click="ShowWarningButton_Click" Margin="225,154,225,240"/>
        <Button
             x:Name="ShowErrorButton"
             Content="Show Error Message"
             Width="350"
             Height="40"
             Background ="IndianRed"
             Click="ShowErrorButton_Click" Margin="225,199,225,195"/>
        <Button
             x:Name="ShowQuestionMessage"
             Content="Show Question Message"
             Width="350"
             Height="40"
             Background ="LightGreen"
             Click="ShowQuestionButton_Click" Margin="225,244,225,150"/>
        <Button
             x:Name="ShowAdvancedConfirmation"
             Content="Show Advance Confirmation"
             Width="350"
             Height="40"
             Background ="LightGray"
             Click="ShowAdvancedButton_Click" Margin="225,289,225,105"/>

    </Grid>
</Window>
