<Window x:Class="WPF_Class_Act_2_Lab_6.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_Class_Act_2_Lab_6"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <Window.Resources>

        <Style x:Key="ForegroundSelectionStyle"
           TargetType="RadioButton">

            <Style.Triggers>
                <Trigger Property="IsChecked"
                     Value="True">

                    <Setter Property="Foreground"
                        Value="{Binding RelativeSource={RelativeSource Self}, 
                                        Path=Content}" />

                </Trigger>

            </Style.Triggers>

        </Style>

        <Style x:Key="BackgroundSelectionStyle"
           TargetType="RadioButton">

            <Style.Triggers>
                <Trigger Property="IsChecked"
                     Value="True">

                    <Setter Property="Background"
                        Value="{Binding RelativeSource={RelativeSource Self},
                                        Path=Content}"  />
                </Trigger>
            </Style.Triggers>

        </Style>

    </Window.Resources>

    <StackPanel HorizontalAlignment="Center">
        <Viewbox>
            <TextBlock Width="300">Foreground Color:</TextBlock>
        </Viewbox>
        
        <RadioButton Content="Red"
            GroupName="ForegroundGroup"
            Style="{StaticResource ForegroundSelectionStyle}" />

        <RadioButton Content="Blue"
            GroupName="ForegroundGroup"
            Style="{StaticResource ForegroundSelectionStyle}" />

        <RadioButton Content="Green"
            GroupName="ForegroundGroup"
            Style="{StaticResource ForegroundSelectionStyle}" />

        <Viewbox>
            <TextBlock Width="300">Background Color:</TextBlock>
        </Viewbox>

        <RadioButton Content="Red"
            GroupName="BackgroundGroup"
            Style="{StaticResource BackgroundSelectionStyle}" />

        <RadioButton Content="Blue"
            GroupName="BackgroundGroup"
            Style="{StaticResource BackgroundSelectionStyle}" />

        <RadioButton Content="Green"
            GroupName="BackgroundGroup"
            Style="{StaticResource BackgroundSelectionStyle}" />

    </StackPanel>
</Window>
