<Window x:Class="WPF_Class_Act_2_Lab_5.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_Class_Act_2_Lab_5"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        
        <StackPanel Margin="20">
            <TextBlock Text="Foreground Color:"
                       FontSize="18"/>

            <RadioButton Content="Red"
                         GroupName="ForegroundGroup"
                         IsChecked="True"/>

            <RadioButton Content="Blue"
                         GroupName="ForegroundGroup"/>

            <RadioButton Content="Green"
                         GroupName="ForegroundGroup"/>

            <TextBlock Text="Background Color:"
                       FontSize="18"
                       Margin="0,20,0,0"/>

            <RadioButton Content="Red"
                        GroupName="BackgroundGroup"/>

            <RadioButton Content="Blue"
                        GroupName="BackgroundGroup"/>

            <RadioButton Content="Green"
                         GroupName="BackgroundGroup"
                         IsChecked="True"/>
        </StackPanel>
    </Grid>
</Window>
