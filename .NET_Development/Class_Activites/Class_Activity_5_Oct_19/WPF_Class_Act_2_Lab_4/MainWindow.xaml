<Window x:Class="WPF_Class_Act_2_Lab_4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_Class_Act_2_Lab_4"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <StackPanel Margin="25">

            <CheckBox x:Name="EngineCheckBox"
                      Content="Engine Off"
                      FontSize="22"
                      IsThreeState="True"
                      IsChecked="False"
                      Checked="EngineCheckBox_Checked"
                      Unchecked="EngineCheckBox_Unchecked"
                      Indeterminate="EngineCheckBox_Indeterminate" />

            <CheckBox x:Name="AudioCheckBox"
                      Content="Enable Audio"
                      IsEnabled="False"
                      Margin="20,20,0,5" />

            <CheckBox x:Name="WipersCheckBox"
                      Content="Enable Wipers"
                      IsEnabled="False"
                      Margin="20,0,0,5" />

            <CheckBox x:Name="AcCheckBox"
                      Content="Enable AC"
                      IsEnabled="False"
                      Margin="20,0,0,5" />
        </StackPanel>
    </Grid>
</Window>
