<Window x:Class="SportsCentreManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Community Sports Centre — Membership Registration"
        Height="720" Width="1000"
        MinHeight="620" MinWidth="880">

    <!-- =================================================================== -->
    <!-- Part F: Window Resources (Styles, Resources, and Triggers)          -->
    <!-- =================================================================== -->
    <Window.Resources>
        <!-- 1. Implicit Style for all TextBox controls (Part F Req 1) -->
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#1E3A8A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 2. Explicit Style for Primary Action Buttons (Part F Req 2 & 3) -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1B5E94"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderBrush" Value="#154B77"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Mouse Hover & Pressed Triggers (Part F Req 3) -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2572B2"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#0D3B66"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#12446E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 3. Explicit Style for Confirm Registration Button (Green theme with hover trigger) -->
        <Style x:Key="ConfirmButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2E7D32"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderBrush" Value="#1B5E20"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Mouse Hover & Pressed Triggers (Part F Req 3) -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#388E3C"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#1B5E20"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1B5E20"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 4. Explicit Style for Clear Form Button (Neutral theme with hover trigger) -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F8F9FA"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Mouse Hover & Pressed Triggers (Part F Req 3) -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E2E8F0"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Part A.2: Main Grid to organize the application rows -->
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <!-- Row 0: Header with Viewbox (Auto sized to fit content) -->
            <RowDefinition Height="Auto"/>
            <!-- Row 1: Main registration & summary content (takes available space) -->
            <RowDefinition Height="*"/>
            <!-- Row 2: Action Buttons Bar (Part D) -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Part A.6 & Part E.2: Viewbox with WelcomeMessage bound to code-behind property -->
        <Viewbox Grid.Row="0" Stretch="Uniform" Height="65" Margin="0,0,0,15">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="Community Sports Centre" 
                           FontSize="24" 
                           FontWeight="Bold" 
                           HorizontalAlignment="Center"
                           Foreground="#1E3A8A"/>
                <TextBlock Text="{Binding WelcomeMessage}" 
                           FontSize="14" 
                           HorizontalAlignment="Center" 
                           Margin="0,4,0,0"
                           Foreground="#4B5563"/>
            </StackPanel>
        </Viewbox>

        <!-- Main Content Area: Nested Grid with 3 columns (Part A.2) -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="1.1*"/>
            </Grid.ColumnDefinitions>

            <!-- Column 0: Member Information & Optional Services -->
            <Grid Grid.Column="0" Margin="0,0,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Part A.4: Member Information Section (StackPanel inside GroupBox) -->
                <GroupBox Grid.Row="0" Header="Member Information" Margin="0,0,0,10" Padding="10">
                    <StackPanel>
                        <Label Content="Full Name:"/>
                        <TextBox x:Name="txtName" Margin="0,0,0,10"/>

                        <Label Content="Email Address:"/>
                        <TextBox x:Name="txtEmail" Margin="0,0,0,10"/>

                        <Label Content="Phone Number:"/>
                        <TextBox x:Name="txtPhone" Margin="0,0,0,5"/>
                    </StackPanel>
                </GroupBox>

                <!-- Part C.1-2: Optional Services CheckBoxes -->
                <GroupBox Grid.Row="1" Header="Optional Services" Padding="10">
                    <StackPanel>
                        <CheckBox x:Name="chkTraining" 
                                  Content="Personal Training — $40/month" 
                                  IsEnabled="False" 
                                  Margin="0,6" 
                                  Click="OptionalService_Click"/>
                        <CheckBox x:Name="chkLocker" 
                                  Content="Locker Rental — $10/month" 
                                  IsEnabled="False" 
                                  Margin="0,6" 
                                  Click="OptionalService_Click"/>
                        <CheckBox x:Name="chkClasses" 
                                  Content="Group Fitness Classes — $20/month" 
                                  IsEnabled="False" 
                                  Margin="0,6" 
                                  Click="OptionalService_Click"/>
                    </StackPanel>
                </GroupBox>
            </Grid>

            <!-- Column 1: Membership Package, Facility & Registration Status -->
            <Grid Grid.Column="1" Margin="8,0,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Part B.1-3: Membership Package (Independent RadioButton Group) -->
                <GroupBox Grid.Row="0" Header="Membership Package" Margin="0,0,0,10" Padding="10">
                    <StackPanel>
                        <RadioButton x:Name="rbBasic" 
                                     Content="Basic — $30/month" 
                                     GroupName="MembershipGroup" 
                                     IsChecked="True" 
                                     Margin="0,4" 
                                     Checked="Membership_Checked"/>
                        <RadioButton x:Name="rbStandard" 
                                     Content="Standard — $50/month" 
                                     GroupName="MembershipGroup" 
                                     Margin="0,4" 
                                     Checked="Membership_Checked"/>
                        <RadioButton x:Name="rbPremium" 
                                     Content="Premium — $80/month" 
                                     GroupName="MembershipGroup" 
                                     Margin="0,4" 
                                     Checked="Membership_Checked"/>
                    </StackPanel>
                </GroupBox>

                <!-- Part B.4: Preferred Facility (Independent RadioButton Group) -->
                <GroupBox Grid.Row="1" Header="Preferred Facility" Margin="0,0,0,10" Padding="10">
                    <StackPanel>
                        <RadioButton x:Name="rbGym" 
                                     Content="Gym" 
                                     GroupName="FacilityGroup" 
                                     Margin="0,4" 
                                     Checked="Facility_Checked"/>
                        <RadioButton x:Name="rbPool" 
                                     Content="Swimming Pool" 
                                     GroupName="FacilityGroup" 
                                     Margin="0,4" 
                                     Checked="Facility_Checked"/>
                        <RadioButton x:Name="rbCourt" 
                                     Content="Basketball Court" 
                                     GroupName="FacilityGroup" 
                                     Margin="0,4" 
                                     Checked="Facility_Checked"/>
                    </StackPanel>
                </GroupBox>

                <!-- Part C.3-4: Registration Status (Three-State CheckBox) -->
                <GroupBox Grid.Row="2" Header="Registration Status (Three-State)" Padding="10">
                    <StackPanel>
                        <CheckBox x:Name="chkStatus" 
                                  Content="Registration Status: Not Started" 
                                  IsThreeState="True" 
                                  IsChecked="False" 
                                  FontWeight="SemiBold"
                                  Margin="0,4,0,10" 
                                  Click="RegistrationStatus_Click"/>

                        <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4" Padding="8">
                            <StackPanel TextElement.FontSize="11" TextElement.Foreground="#4B5563">
                                <TextBlock Text="• Not Started — services disabled &amp; unchecked" Margin="0,2"/>
                                <TextBlock Text="• In Progress — services enabled (cannot confirm)" Margin="0,2"/>
                                <TextBlock Text="• Ready to Confirm — services enabled (can confirm)" Margin="0,2"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </GroupBox>
            </Grid>

            <!-- Column 2: Part A.5 Registration Summary Section -->
            <GroupBox Grid.Column="2" Header="Registration Summary" Margin="8,0,0,0" Padding="10">
                <StackPanel>
                    <!-- Part E.1: Data binding between TextBox (txtName) and display TextBlock (lblSummaryName) -->
                    <StackPanel Orientation="Horizontal" Margin="0,6">
                        <Label Content="Member Name:" FontWeight="Bold" Width="110"/>
                        <TextBlock x:Name="lblSummaryName" 
                                   Text="{Binding ElementName=txtName, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,6">
                        <Label Content="Membership:" FontWeight="Bold" Width="110"/>
                        <TextBlock x:Name="lblSummaryMembership" Text="—" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,6">
                        <Label Content="Facility:" FontWeight="Bold" Width="110"/>
                        <TextBlock x:Name="lblSummaryFacility" Text="—" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Label Content="Optional Services:" FontWeight="Bold" Margin="0,8,0,2"/>
                    <TextBlock x:Name="txtSummaryServices" 
                               Text="None" 
                               Margin="5,0,0,10"
                               TextWrapping="Wrap"/>

                    <Separator Margin="0,10"/>

                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <Label Content="Total Monthly Fee:" FontWeight="Bold" FontSize="14" Width="130"/>
                        <TextBlock x:Name="lblSummaryFee" Text="$0.00" FontSize="16" FontWeight="Bold" Foreground="#1E3A8A" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>
        </Grid>

        <!-- Row 2: Part D Action Buttons Bar with Applied Styles (Part F) -->
        <UniformGrid Grid.Row="2" Columns="3" Rows="1" Margin="0,5,0,0">
            <Button x:Name="btnCalculate" 
                    Content="Calculate Monthly Fee" 
                    Style="{StaticResource PrimaryButtonStyle}" 
                    Margin="0,0,10,0" 
                    Height="40" 
                    Click="btnCalculate_Click"/>
            <Button x:Name="btnConfirm" 
                    Content="Confirm Registration" 
                    Style="{StaticResource ConfirmButtonStyle}" 
                    Margin="5,0,5,0" 
                    Height="40" 
                    Click="btnConfirm_Click"/>
            <Button x:Name="btnClear" 
                    Content="Clear Form" 
                    Style="{StaticResource SecondaryButtonStyle}" 
                    Margin="10,0,0,0" 
                    Height="40" 
                    Click="btnClear_Click"/>
        </UniformGrid>
    </Grid>
</Window>